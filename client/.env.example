# Example env for the React/Vite client. Copy to .env.

# Base URL for the Express API. Defaults to http://localhost:5000/api if unset.
VITE_API_BASE_URL=http://localhost:5000/api

# When 'true', API calls use in-memory mocks (see client/src/api/mockReports.ts).
# Set to 'false' to hit the real backend.
VITE_USE_MOCKS=true
